{
  "expo": {
    "name": "Pokémon App",
    "slug": "pokemon-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/RE.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "pokemon-app",
    "splash": {
      "image": "./assets/RE.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personal.pokemonapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/RE.png",
        "backgroundColor": "#0f0f1a"
      },
      "package": "com.personal.pokemonapp",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "88362673-33ec-4b31-b83c-796edfa2d880"
      }
    }
  }
}
